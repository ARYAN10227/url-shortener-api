PORT=3000
MONGODB_URI=
MONGODB_DB_NAME=url_shortener
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
# Public demo account (one-click "Try the demo" on the frontend). Set DEMO_ENABLED=false to turn it off.
DEMO_ENABLED=true
DEMO_EMAIL=demo@urlshortener.dev
DEMO_PASSWORD=demo1234
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY_HOPS=1
